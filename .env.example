# ==============================================
# RetailIQ Environment Variables Template
# ==============================================

# System & Environment
ENVIRONMENT=development
LOG_LEVEL=INFO

# Backend API Configuration
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
CORS_ORIGINS=http://localhost:3000

# Frontend Configuration
NEXT_PUBLIC_API_URL=http://localhost:8000

# Google Cloud Platform
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_REGION=us-central1
GOOGLE_APPLICATION_CREDENTIALS=

# Vertex AI & Gemini
GEMINI_MODEL=gemini-2.5-flash
VERTEX_AI_SEARCH_DATASTORE_ID=

# BigQuery Analytics
BIGQUERY_DATASET=retailiq_analytics
BIGQUERY_LOCATION=US

# Database / Storage (Cloud SQL / Cloud Storage)
GCS_BUCKET_NAME=retailiq-data-assets
DATABASE_URL=sqlite:///./retailiq.db
