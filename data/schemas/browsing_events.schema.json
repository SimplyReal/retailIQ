{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "BrowsingEvent",
  "description": "RetailIQ clickstream and product view event schema",
  "type": "object",
  "properties": {
    "event_id": {
      "type": "string",
      "pattern": "^BRW-[0-9]{5,}$",
      "description": "Unique browsing event identifier"
    },
    "customer_id": {
      "type": "string",
      "pattern": "^CUST-[0-9]{4,}$",
      "description": "FK referencing customers.customer_id"
    },
    "product_id": {
      "type": "string",
      "pattern": "^PROD-[0-9]{4,}$",
      "description": "FK referencing products.product_id"
    },
    "event_type": {
      "type": "string",
      "enum": ["view", "click", "scroll", "hover"],
      "description": "Type of interaction"
    },
    "duration": {
      "type": "integer",
      "minimum": 0,
      "description": "Dwell time on product in seconds"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "description": "ISO 8601 UTC timestamp of interaction"
    }
  },
  "required": [
    "event_id",
    "customer_id",
    "product_id",
    "event_type",
    "duration",
    "timestamp"
  ],
  "additionalProperties": false
}
