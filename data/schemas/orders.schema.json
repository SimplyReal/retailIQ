{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Order",
  "description": "RetailIQ transaction order item schema",
  "type": "object",
  "properties": {
    "order_id": {
      "type": "string",
      "pattern": "^ORD-[0-9]{5,}$",
      "description": "Unique order transaction identifier"
    },
    "customer_id": {
      "type": "string",
      "pattern": "^CUST-[0-9]{4,}$",
      "description": "FK referencing customers.customer_id"
    },
    "product_id": {
      "type": "string",
      "pattern": "^PROD-[0-9]{4,}$",
      "description": "FK referencing products.product_id"
    },
    "quantity": {
      "type": "integer",
      "minimum": 1,
      "description": "Units purchased"
    },
    "price": {
      "type": "number",
      "minimum": 0,
      "description": "Unit selling price in INR"
    },
    "discount": {
      "type": "number",
      "minimum": 0,
      "description": "Total discount value applied in INR"
    },
    "order_date": {
      "type": "string",
      "format": "date-time",
      "description": "ISO 8601 UTC timestamp of purchase"
    },
    "channel": {
      "type": "string",
      "enum": ["online", "in-store", "app"],
      "description": "Sales channel"
    }
  },
  "required": [
    "order_id",
    "customer_id",
    "product_id",
    "quantity",
    "price",
    "discount",
    "order_date",
    "channel"
  ],
  "additionalProperties": false
}
