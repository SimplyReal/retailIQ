{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Store",
  "description": "RetailIQ retail store master schema",
  "type": "object",
  "properties": {
    "store_id": {
      "type": "string",
      "pattern": "^STORE-[0-9]{3,}$",
      "description": "Unique retail store identifier"
    },
    "location": {
      "type": "string",
      "description": "City and neighborhood name"
    },
    "format": {
      "type": "string",
      "enum": ["Flagship", "Express", "Outlet", "Warehouse"],
      "description": "Retail store format"
    },
    "region": {
      "type": "string",
      "enum": ["North", "South", "East", "West", "Central"],
      "description": "Geographic operational region"
    }
  },
  "required": [
    "store_id",
    "location",
    "format",
    "region"
  ],
  "additionalProperties": false
}
